---
/* Visit and host a team. Content: 04-visit-host-a-team.md. Facility facts and
   two FAQ answers are all that is confirmed; the trip, provide/provide, and
   team-fit sections are cut. The content file flags that this page cannot do
   its persuasion job yet; that sequencing call is not made here. */
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Hero from '../../components/Hero.astro';
import Trek from '../../components/Trek.astro';
import Blueprint from '../../components/Blueprint.astro';
import Faq from '../../components/Faq.astro';
import { href, localeFromParams, localePaths, useTranslations } from '../../i18n/utils';
export const getStaticPaths = localePaths;
const lang = localeFromParams(Astro.params.locale);
const t = useTranslations(lang);
---
<Base lang={lang} page="visit" title={t('visit.title')} description={t('visit.description')}>

  <Hero lang={lang} titleId="page-title" title={t('visit.h1')} sub={t('visit.sub')}>
    <Button href={href(lang, 'contact')} onDark>{t('visit.cta')}</Button>
  </Hero>

  <!-- The trek: scroll-drawn map, this page only. No trip logistics beside it
       on purpose; the point is that it works without information we lack. -->
  <Trek lang={lang} />

  <section class="tex bg-page" aria-labelledby="facts-title">
    <div class="fg-whisper-light tex__tile--edge-l" aria-hidden="true"></div>
    <div class="fg-whisper-light tex__tile--edge-r" aria-hidden="true"></div>
    <div class="wrap section">
      <div class="building__grid building__grid--top">
        <div>
          <p class="eyebrow">{t('visit.facts.eyebrow')}</p>
          <h2 id="facts-title" class="section-title">{t('visit.facts.title')}</h2>
          <ol class="factlist">
            <li class="facts__item"><span class="facts__num" aria-hidden="true">01</span><span>{t('visit.facts.1')}</span></li>
            <li class="facts__item"><span class="facts__num" aria-hidden="true">02</span><span>{t('visit.facts.2')}</span></li>
            <li class="facts__item"><span class="facts__num" aria-hidden="true">03</span><span>{t('visit.facts.3')}</span></li>
            <li class="facts__item"><span class="facts__num" aria-hidden="true">04</span><span>{t('visit.facts.4')}</span></li>
          </ol>
        </div>
        <div><Blueprint lang={lang} /></div>
      </div>
    </div>
  </section>

  <Faq lang={lang} items={[
    { q: t('visit.faq.q1'), a: t('visit.faq.a1') },
    { q: t('visit.faq.q2'), a: t('visit.faq.a2') },
  ]} />

</Base>
