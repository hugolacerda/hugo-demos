---
/* Home. Content: 01-home.md. The trust strip is cut entirely and nothing
   replaces it; the page flows from "what we do" straight into the building. */
import Base from '../../layouts/Base.astro';
import Button from '../../components/Button.astro';
import Hero from '../../components/Hero.astro';
import Blueprint from '../../components/Blueprint.astro';
import Faq from '../../components/Faq.astro';
import { href, localeFromParams, localePaths, useTranslations } from '../../i18n/utils';
export const getStaticPaths = localePaths;
const lang = localeFromParams(Astro.params.locale);
const t = useTranslations(lang);
// The phrase in the headline that carries the argument, per locale. Must
// match the title string exactly or Hero leaves the title unwrapped.
const emph = { en: 'not just a check', es: 'no solo un cheque' }[lang];
---
<Base lang={lang} page="home" title={t('home.title')} description={t('home.description')}>

  <!-- Hero: shared component, full-bleed. "not just a check" is wrapped for
       the scroll-driven emphasis below; the phrase is a substring of the
       existing i18n title in each locale, not new copy. -->
  <Hero lang={lang} title={t('home.hero.title')} emph={emph} sub={t('home.hero.sub')}>
    <Button href={href(lang, 'visit')} onDark>{t('home.hero.cta.host')}</Button>
    <Button href={href(lang, 'give')} variant="secondary" onDark>{t('home.hero.cta.support')}</Button>
  </Hero>

  <!-- Quick facts: three, not four. Whisper light. -->
  <section class="facts tex bg-whisper" aria-labelledby="facts-title">
    <div class="fg-whisper-light tex__tile" aria-hidden="true"></div>
    <h2 id="facts-title" class="visually-hidden">{t('home.facts.title')}</h2>
    <ul class="facts__list">
      <li class="facts__item"><span class="facts__num" aria-hidden="true">01</span><span>{t('home.facts.1')}</span></li>
      <li class="facts__item"><span class="facts__num" aria-hidden="true">02</span><span>{t('home.facts.2')}</span></li>
      <li class="facts__item"><span class="facts__num" aria-hidden="true">03</span><span>{t('home.facts.3')}</span></li>
    </ul>
  </section>

  <!-- What we do. One paragraph and one link, as 01-home.md specifies. -->
  <section class="tex bg-page" aria-labelledby="what-title">
    <div class="fg-whisper-light tex__tile--edge-l" aria-hidden="true"></div>
    <div class="fg-whisper-light tex__tile--edge-r" aria-hidden="true"></div>
    <div class="wrap section--lead">
      <div class="text-col">
        <h2 id="what-title" class="section-title section-title--lead">{t('home.what.title')}</h2>
        <p class="lede">{t('home.what.body')}</p>
        <div class="mt-[26px]">
          <Button href={href(lang, 'programs')} variant="secondary">{t('home.what.link')}</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- The building. Whisper at the edges only; the cross-section owns the centre. -->
  <section class="tex bg-page" aria-labelledby="bld-title">
    <div class="fg-whisper-light tex__tile--edge-l" aria-hidden="true"></div>
    <div class="fg-whisper-light tex__tile--edge-r" aria-hidden="true"></div>
    <div class="wrap section">
      <div class="building__grid">
        <div>
          <p class="eyebrow">{t('bld.eyebrow')}</p>
          <h2 id="bld-title" class="section-title">{t('home.bld.title')}</h2>
          <p class="lede">{t('home.bld.lede')}</p>
        </div>
        <div><Blueprint lang={lang} /></div>
      </div>
    </div>
  </section>

  <Faq lang={lang} items={[
    { q: t('home.faq.q1'), a: t('home.faq.a1') },
    { q: t('home.faq.q2'), a: t('home.faq.a2'), link: { href: href(lang, 'contact'), label: t('link.contact') } },
    { q: t('home.faq.q3'), a: t('home.faq.a3'), link: { href: href(lang, 'give'), label: t('link.give') } },
  ]} />

  <script>
    // Home only: as the hero scrolls out of view, "not just a check" grows and
    // the rest of the headline recedes. Scrubbed to scroll through GSAP's
    // ticker (shared with Lenis in scripts/motion.ts). Skipped entirely under
    // prefers-reduced-motion, where the static headline is the finished state.
    import { gsap, reduceMotion } from '../../scripts/motion';
    const hero = document.querySelector<HTMLElement>('[data-hero]');
    const emph = hero?.querySelector<HTMLElement>('.hero__emph');
    if (hero && emph && !reduceMotion) {
      const rest = hero.querySelectorAll<HTMLElement>('.hero__rest');
      const inner = hero.querySelector<HTMLElement>('.hero__inner')!;
      const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue('--header-h')) || 69;
      // Starts with the first pixel of scroll and finishes the moment the
      // sticky copy runs out of hero to stick to, so the whole zoom is seen.
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: hero,
          start: () => `top top+=${headerH}`,
          end: () => `bottom top+=${headerH + inner.offsetHeight}`,
          scrub: 0.4,
          invalidateOnRefresh: true,
        },
      });
      tl.to(emph, { scale: 1.22, ease: 'none' }, 0)
        .to(rest, { opacity: 0.55, ease: 'none' }, 0);
    }
  </script>
</Base>
