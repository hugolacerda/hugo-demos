---
/* Document shell. One layout for both locales: <html lang>, per-page title
   and description, hreflang alternates, self-hosted font preloads, header,
   footer, and the two client scripts. */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { href, languages, useTranslations, type Lang, type PageId } from '../i18n/utils';
interface Props { lang: Lang; page: PageId; title: string; description: string }
const { lang, page, title, description } = Astro.props;
const t = useTranslations(lang);
const locales = Object.keys(languages) as Lang[];
// Absolute alternates need `site` in astro.config.mjs, which stays unset
// until a domain exists. Until then these are root-relative.
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="theme-color" content="#0E3A32" />
  <meta name="generator" content={Astro.generator} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {locales.map((l) => <link rel="alternate" hreflang={l} href={abs(href(l, page))} />)}
  <link rel="alternate" hreflang="x-default" href={abs(href('en', page))} />
  <link rel="preload" href="/fonts/fraunces-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/instrument-sans-latin.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/jetbrains-mono-latin.woff2" as="font" type="font/woff2" crossorigin />
</head>
<body>
  <a class="skip-link" href="#main">{t('skip')}</a>
  <Header lang={lang} page={page} />
  <main id="main">
    <slot />
  </main>
  <Footer lang={lang} />
  <script>
    import '../scripts/site';
    import '../scripts/motion';
  </script>
</body>
</html>
