---
/* FAQ: native details/summary, no custom JS. Plain this round; the design
   system still has no texture tier assigned to it. */
import Arrow from './Arrow.astro';
import type { Lang } from '../i18n/utils';
import { useTranslations } from '../i18n/utils';
export interface FaqItem { q: string; a: string; link?: { href: string; label: string } }
interface Props { lang: Lang; items: FaqItem[]; id?: string }
const { lang, items, id = 'faq-title' } = Astro.props;
const t = useTranslations(lang);
---
<section class="section--card" aria-labelledby={id}>
  <div class="wrap section">
    <h2 id={id} class="section-title">{t('faq.title')}</h2>
    <div class="faq">
      {items.map((item) => (
        <details>
          <summary><span>{item.q}</span><span class="faq__sign" aria-hidden="true">+</span></summary>
          <div class="faq__answer">
            <p>{item.a}</p>
            {item.link && <p><a class="inline-link" href={item.link.href}><span>{item.link.label}</span><Arrow class="" /></a></p>}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
