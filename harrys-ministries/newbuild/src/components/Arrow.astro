---
/* The trailing arrow used by both CTA treatments and inline links. */
interface Props { size?: number; class?: string }
const { size = 13, class: className = 'btn__arrow' } = Astro.props;
---
<svg class={className} aria-hidden="true" width={size} height={size} viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="square"><path d="M2.5 7h8"/><path d="M7 3.5 10.5 7 7 10.5"/></svg>
