---
// The one page shell every template uses (map ticket 08). The head reproduces
// the live site's, in the live order, with the CDN files vendored
// (public/vendor, scripts/vendor.mjs) and every path root-relative
// (ticket 06: the live relative paths break on the pagination pages).
//
// Not carried over on purpose: the GA4 tag (ticket 18, after Gary's approval),
// the three reCAPTCHA tags and jquery.validate (forms, ticket 13), the MeclabsAI
// chat widget (out of scope), jQuery with its plugins and their CSS (Owl,
// fancybox; ticket 09 replaced each behaviour: src/scripts/, port.css).
//
// Search and sharing (ticket 15, src/lib/seo.ts): the title, description and
// canonical as live, except the eight core pages whose generic live title and
// description META replaces (applied here by path, so every caller gets it);
// descriptions with their line breaks collapsed; Open Graph and Twitter tags
// (empty live) from the page's own title, description and banner; the icons
// from scripts/favicon.py (the live site has none).
import { FONT_STYLESHEET } from '../site.config';
import { META, DEFAULT_IMAGE, absolute, clean } from '../lib/seo';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ReadinessModal from '../components/ReadinessModal.astro';
import NewsletterModal from '../components/NewsletterModal.astro';
import SchemaLocalBusiness from '../components/SchemaLocalBusiness.astro';

interface Props {
  title: string;
  description: string;
  /** The page's path, e.g. "/" or "/start-here"; builds the canonical URL. */
  path: string;
  /** The canonical path when it is not `path` (near-duplicate articles), or null for none (404). */
  canonical?: string | null;
  /** Banner image path for the sharing tags; pages without one share DEFAULT_IMAGE. */
  image?: string | null;
  /** Open Graph type: articles are `article`. */
  type?: 'website' | 'article';
  /** The 404 page is `noindex`. */
  noindex?: boolean;
  /** The homepage omits the `inner-header` class on the desktop nav. */
  home?: boolean;
}
const { path, canonical: canonicalOverride, image, type = 'website', noindex = false, home = false } = Astro.props;
const title = META[path]?.title ?? Astro.props.title;
const description = clean(META[path]?.description ?? Astro.props.description);
const canonicalPath = canonicalOverride === undefined ? path : canonicalOverride;
const canonical = canonicalPath === null ? null : absolute(canonicalPath);
const shareImage = absolute(image ?? DEFAULT_IMAGE);
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="format-detection" content="telephone=no">
    <title>{title}</title>
    <meta name="description" content={description}>
    {noindex && <meta name="robots" content="noindex">}
    {canonical && <link rel="canonical" href={canonical}>}
    <meta property="og:type" content={type}>
    <meta property="og:site_name" content="Gateway Business Advisors">
    <meta property="og:locale" content="en_US">
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    {canonical && <meta property="og:url" content={canonical}>}
    <meta property="og:image" content={shareImage}>
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={shareImage}>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" href="/favicon.png" type="image/png">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <link href="/vendor/bootstrap-5.3.8/css/bootstrap.min.css" rel="stylesheet">
    <link href="/css/bootstrap53-compat.css" rel="stylesheet">
    <link href="/css/custom.css" rel="stylesheet">
    <link href="/css/flexslider.css" rel="stylesheet">
    <link href={FONT_STYLESHEET} rel="stylesheet">
    <link href="/vendor/fontawesome-6.5.2/css/all.min.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="/css/port.css" rel="stylesheet">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap" rel="stylesheet">
    <SchemaLocalBusiness path={path} />
  </head>
  <body>
    <header>
      <SiteHeader home={home} />
    </header>
    <main>
      <slot />
    </main>
    <SiteFooter />
    <ReadinessModal />
    <NewsletterModal />
    <script>
      // Bootstrap's Offcanvas, Collapse and Modal with their data-api (ticket 09).
      import '../scripts/bootstrap';
      // The contact and newsletter forms: load time, phone mask, returned messages (ticket 13).
      import { initForms } from '../scripts/forms';
      initForms();
    </script>
  </body>
</html>
