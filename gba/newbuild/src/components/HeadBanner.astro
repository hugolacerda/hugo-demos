---
// The banner at the top of every inner page: the banner image and the visible
// banner text, which is the page's H1 (map Notes, headings; live it is an h2,
// port.css carries the h2 styling over to h1). The markup is the live
// headbanner block from src/content/pages/*.html, which the content loader
// strips from each page body (src/loaders/html-content.ts).
interface Props {
  banner: string;
  alt: string | null;
  title: string;
}
const { banner, alt, title } = Astro.props;
---
<div class="">
  <div class="headbanner">
    <img alt={alt ?? ''} height="463" src={banner} style="width:100%;height:auto" width="1920" />
    <div class="breadcrumb">
      <div class="container">
        <div class="row align-items-center">
          <div class="col-xl-12 col-lg-12 col-md-12 col-sm-12 text-xl-start text-lg-start text-md-start text-sm-center">
            <h1 class="mb-0">{title}</h1>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="bodyheader">
  </div>
</div>
