---
// The affiliation-logo strip between the contact block and the footer on the
// homepage, /affiliations and /contact-us (harvest/2026-10-24: 3 pages). An Owl
// carousel live (ticket 03), Embla here (ticket 09, src/scripts/carousel.ts) on
// Owl's rendered markup. Logos in live order; alt text as live (the empty alts
// are on the ticket 07 review list).
import { owlMarkup } from '../lib/html';

const logos: { src: string; alt?: string }[] = [
  { src: '/upload/links/551732630532CM_&_AP.png', alt: '' },
  { src: '/upload/links/5931732630441CBI.png', alt: '' },
  { src: '/images/ibba-logo.png' },
  { src: '/upload/links/9821732630267M&_AMI.png', alt: '' },
  { src: '/upload/links/981732127049FPA1.png', alt: '' },
  { src: '/upload/links/3171732126708ACGGlobal_wAssociationForCorporateGrowth_RGB_1.png', alt: '' },
  { src: '/upload/links/6931732127662Jax.png', alt: '' },
  { src: '/upload/links/2021732126322EPI-Live-Logo_Full_Color-1.webp', alt: '' },
  { src: '/upload/links/1471732126172logo.png', alt: '' },
  { src: '/upload/links/6691732125595logo-cia-header.webp', alt: '' },
  { src: '/upload/links/6521730801603IBBA1.png', alt: '' },
  { src: '/upload/links/7691729613462m-a-source-2.png', alt: '' },
  { src: '/upload/links/2271729612058bbf.png', alt: '' },
];

const items = logos.map((l) => {
  const alt = l.alt === undefined ? '' : ` alt="${l.alt}"`;
  return `<div class="item"><img src="${l.src.replaceAll('&', '&amp;')}"${alt} class="img-fluid" width="370" height="103"></div>`;
});
---
<div class="client-logo">
  <div class="container">
    <div class="row align-items-center justify-content-center">
      <div class="col-lg-10">
        <Fragment set:html={owlMarkup('<div class="owl-carousel" id="client-logo">', items)} />
      </div>
    </div>
  </div>
</div>

<script>
  import { initCarousels } from '../scripts/carousel';
  initCarousels();
</script>
