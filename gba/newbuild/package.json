{
  "name": "gba-newbuild",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "gatewaybusinessadvisors.com rebuilt as a static Astro site: a 1:1 port of the live site's markup and CSS, deployed on Netlify from gba/newbuild.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "vendor": "node scripts/vendor.mjs",
    "redirects": "node scripts/redirects.mjs",
    "headers": "node scripts/headers.mjs",
    "predev": "npm run vendor && npm run redirects",
    "dev": "astro dev",
    "prebuild": "npm run vendor && npm run redirects",
    "build": "astro build",
    "postbuild": "npm run headers",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "~7.3.3",
    "embla-carousel": "8.6.0",
    "embla-carousel-autoplay": "8.6.0",
    "js-yaml": "^5.5.0"
  },
  "devDependencies": {
    "@fontsource-variable/cinzel": "^5.3.0",
    "@fontsource/metropolis": "^5.3.0",
    "@fortawesome/fontawesome-free": "6.5.2",
    "@netlify/functions": "^6.0.3",
    "bootstrap": "5.3.8"
  }
}
